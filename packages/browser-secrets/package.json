{
  "name": "@turnkey/browser-secrets",
  "version": "0.0.1-alpha.1",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./fixtures/*.json": "./fixtures/*.json",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "license": "Apache-2.0",
  "description": "Destination binding, target authorization, and output redaction for browser agents that fill stored secrets, with Turnkey as the default source",
  "keywords": [
    "Turnkey",
    "secrets",
    "browser",
    "agent",
    "redaction"
  ],
  "author": {
    "name": "Turnkey",
    "url": "https://turnkey.com/"
  },
  "homepage": "https://github.com/tkhq/sdk",
  "bugs": {
    "url": "https://github.com/tkhq/sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkhq/sdk.git",
    "directory": "packages/browser-secrets"
  },
  "files": [
    "dist/",
    "fixtures/",
    "CHANGELOG.md",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "build": "rollup -c",
    "clean": "rimraf ./dist ./.cache",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "urlpattern-polyfill": "10.1.0"
  }
}
