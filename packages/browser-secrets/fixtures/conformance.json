        "sbm:fields": "{\"number\":\"input[name=cardNumber]\",\"cvc\":\"input[name=cardCvc]\"}"
      },
      "expect": {
        "status": "bound",
        "binding": {
          "origin": "https://shop.example",
          "frameOrigin": "https://pay.example",
          "urlPattern": "/checkout*",
          "selector": "input[name=cardNumber]",
          "fields": {
            "number": "input[name=cardNumber]",
            "cvc": "input[name=cardCvc]"
          }
        }
      }
    },
