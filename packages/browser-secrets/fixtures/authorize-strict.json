{
  "description": "Stricter M1 rules and observation checks that SBM does not have yet.",
  "cases": [
    {
      "kind": "authorize",
      "name": "an explicit sbm:selector permits an unkeyed fill of a field-bound secret",
      "source": "secure-browser-mcp@599e7d5 src/tools/fill-common.ts validateTargets (\"Without its own sbm:selector, an unkeyed fill ... is refused\")",
      "secret": {
        "secretId": "card-1",
        "staticProperties": {
          "sbm:origin": "https://shop.example",
          "sbm:fields": "{\"number\":\"input[name=cardNumber]\",\"cvc\":\"input[name=cardCvc]\"}",
          "sbm:selector": "textarea[name=card]"
        }
      },
      "request": {
        "targets": [
          {
            "elementId": "card"
          }
        ]
      },
      "observation": {
        "browserSessionId": "session-1",
        "tabId": "tab-1",
        "topLevelUrl": "https://shop.example/checkout",
        "targets": [
          {
            "elementId": "card",
            "frames": [
              {
                "frameId": "main",
                "documentId": "doc-main-63",
                "url": "https://shop.example/checkout",
                "origin": "https://shop.example"
              }
            ],
            "selectorMatches": {
              "textarea[name=card]": true
            }
          }
        ]
      },
      "expect": {
        "allowed": true
      }
    },
    {
      "kind": "authorize",
      "name": "refuses one element named twice with different keys",
      "source": "browser-secrets M1 strict rule: one element receives at most one value (SBM deduplicates key+element only)",
      "secret": {
        "secretId": "card-2",
        "staticProperties": {
          "sbm:origin": "https://shop.example",
          "sbm:fields": "{\"number\":\"input[name=cardNumber]\",\"cvc\":\"input[name=cardCvc]\"}"
        }
      },
      "request": {
        "targets": [
          {
            "key": "number",
            "elementId": "cardNumber"
          },
          {
            "key": "cvc",
            "elementId": "cardNumber"
          }
        ]
      },
      "observation": {
        "browserSessionId": "session-1",
        "tabId": "tab-1",
        "topLevelUrl": "https://shop.example/checkout",
        "targets": [
          {
            "elementId": "cardNumber",
            "frames": [
              {
                "frameId": "main",
                "documentId": "doc-main-64",
                "url": "https://shop.example/checkout",
                "origin": "https://shop.example"
              }
            ],
            "selectorMatches": {
              "input[name=cardNumber]": true,
              "input[name=cardCvc]": true
            }
          }
        ]
      },
      "expect": {
        "allowed": false,
        "reason": "duplicate_target",
        "targetIndex": 1
      }
    },
