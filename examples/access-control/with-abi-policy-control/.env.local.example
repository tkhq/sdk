TURNKEY_API_PUBLIC_KEY="<Turnkey API Public Key (that starts with 02 or 03)>"
TURNKEY_API_PRIVATE_KEY="<Turnkey API Private Key>"
TURNKEY_BASE_URL="https://api.turnkey.com"
TURNKEY_ORGANIZATION_ID="<Turnkey organization ID>"

DELEGATED_API_PUBLIC_KEY="<Delegated API Public Key (that starts with 02 or 03)>"
DELEGATED_API_PRIVATE_KEY="<Delegated API Private Key>"

# Pre-create this wallet in your parent organization in the Turnkey Dashboard
TREASURY_ADDRESS="<Treasury Ethereum address 0x... that receives USDC sweeps>"
# Sepolia USDC. Change alongside TURNKEY_CAIP2 if you switch chains
USDC_CONTRACT="0x1c7d4b196cb0c7b01d743fbc6116a902379c7238"

# Any Turnkey-supported EVM chain (CAIP-2). Defaults to Sepolia.
TURNKEY_CAIP2="eip155:11155111"

# Turnkey Gas Sponsorship. On by default; set to false to have merchants pay their own gas.
TURNKEY_SPONSOR="true"
