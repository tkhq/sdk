# Server side. Used only by `pnpm create-profile` to create the two session
# profiles on the parent organization.
API_PUBLIC_KEY=""
API_PRIVATE_KEY=""
BASE_URL="https://api.turnkey.com"
ORGANIZATION_ID=""

# Browser. The parent organization and an Auth Proxy config with passkeys
# enabled. Sign-up creates a sub-organization with the passkey as root user.
NEXT_PUBLIC_ORGANIZATION_ID=""
NEXT_PUBLIC_AUTH_PROXY_CONFIG_ID=""

# Session profile id. `pnpm create-profile` prints this line; paste it here.
# Sign-up and login pass it to Turnkey, so the session is scoped from its
# first request.
NEXT_PUBLIC_SESSION_PROFILE_ID=""

# Optional overrides. Defaults shown.
# NEXT_PUBLIC_BASE_URL="https://api.turnkey.com"
# NEXT_PUBLIC_AUTH_PROXY_BASE_URL="https://authproxy.turnkey.com"
# NEXT_PUBLIC_USDC_ADDRESS="0x036CbD53842c5426634e7929541eC2318f3dCF7e"
# NEXT_PUBLIC_MINIBANK_ADDRESS="0xcAdD4bb1Cfcd76C25f3702AD698679CbD934d12E"