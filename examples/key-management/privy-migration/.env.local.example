# --- Turnkey (required for both mock and live modes) ---
API_PUBLIC_KEY="<Turnkey API Public Key (starts with 02 or 03)>"
API_PRIVATE_KEY="<Turnkey API Private Key>"
USER_ID="<Turnkey User ID that will own the imported key>"
ORGANIZATION_ID="<Turnkey Organization (or Sub-Organization) ID>"
BASE_URL="https://api.turnkey.com"

# --- Privy (required for live mode; ignored with --mock) ---
PRIVY_APP_ID="<Privy App ID>"
PRIVY_APP_SECRET="<Privy App Secret>"
# The Privy wallet whose private key you want to migrate.
PRIVY_WALLET_ID="<Privy Wallet ID (e.g. wa_xxx)>"

# --- Privy authorization material (required depends on --ownership) ---
#
# PRIVY_AUTHORIZATION_PRIVATE_KEY: the app's authorization private key,
# base64-encoded PKCS#8 with NO PEM headers (Privy's canonical format;
# see @privy-io/node's AuthorizationContext docs). A "wallet-auth:" prefix
# is tolerated and stripped. Required for:
#   --ownership app     (app-owned wallets; unattended bulk migration)
#   --ownership quorum  (app co-signs alongside user)
PRIVY_AUTHORIZATION_PRIVATE_KEY=""

# PRIVY_USER_JWT: the end user's Privy session JWT (identity token).
# Required for:
#   --ownership user    (user-owned embedded wallets; login-triggered per user)
#   --ownership quorum  (2-of-2 user + app)
# This is per-user and short-lived; obtain it during the user's authenticated
# session and pass it in. See README "Does this work for embedded wallet users?".
PRIVY_USER_JWT=""
