API_PUBLIC_KEY="<Turnkey API Public Key (that starts with 02 or 03)>"
API_PRIVATE_KEY="<Turnkey API Private Key>"
BASE_URL="https://api.turnkey.com"
ORGANIZATION_ID="<Turnkey organization ID>"

# A Turnkey Tron address holding the TRC-20 token but ZERO TRX. Create one
# with the with-tron example's createTronWallet script.
USER_ADDRESS="<Turnkey Tron address holding the TRC-20 token>"

# Where sponsoredTransfer sends the tokens.
RECIPIENT_ADDRESS="TY1jfzP3s94oSzYECC89EFn17iA8S4imVZ"

# TRC-20 token to move. Defaults to USDT on Nile.
TOKEN_ADDRESS="TXYZopYRdj2D9XRtbG411XZZ3kM5VkAeBf"

# Raw token amount (USDT has 6 decimals; 1000000 = 1 USDT).
TOKEN_AMOUNT="1000000"

# Node endpoint. Defaults to Nile; the JustLend provider needs mainnet, and
# TronGrid rejects anonymous mainnet traffic — set an API key with it.
# TRON_FULL_HOST="https://api.trongrid.io"
# TRONGRID_API_KEY=""

# Where the energy comes from: tronsave (marketplace API, Nile-capable) or
# justlend (on-chain contract, mainnet only).
ENERGY_PROVIDER="tronsave"

# --- tronsave ---
# API key from https://tronsave.io. The default base URL is the dev API,
# which delegates on Nile; use https://api.tronsave.io/v2 for mainnet. Orders
# are paid from the prepaid account tied to the key (GET /user-info shows its
# TRX deposit address).
TRONSAVE_API_KEY="<TronSave API key>"
# TRONSAVE_API_BASE_URL="https://api.tronsave.io/v2"
# Refuse rentals above this market price, in SUN per energy.
MAX_PRICE_SUN="150"

# --- justlend (mainnet only) ---
# Turnkey-held wallet holding TRX: it pays the rentResource prepay and signs
# the rent/return transactions.
# SPONSOR_ADDRESS="<Turnkey Tron address with TRX>"
# JUSTLEND_CONTRACT_ADDRESS="TU2MJ5Veik1LRAgjeSzEdvmDYx7mefJZvd"
