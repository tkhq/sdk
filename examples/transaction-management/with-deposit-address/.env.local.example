# Parent organization and Auth Proxy (Turnkey dashboard)
NEXT_PUBLIC_ORGANIZATION_ID="<Turnkey parent organization ID>"
NEXT_PUBLIC_AUTH_PROXY_CONFIG_ID="<Auth Proxy Config ID>"

# Optional. Pre-fills the destination field on the Enable form, to make testing
# easier. Each user still chooses and approves their own destination.
NEXT_PUBLIC_DEFAULT_DESTINATION_ADDRESS=""

# Delegated key: a P-256 API key pair the platform holds.
# The public key is not secret; the browser needs it to create the delegated user.
NEXT_PUBLIC_DA_PUBLIC_KEY="<Compressed P-256 public key, 66 hex chars, no 0x>"
# Server only. Never prefix this with NEXT_PUBLIC_.
TURNKEY_DA_PRIVATE_KEY="<P-256 private key for the delegated user>"

# Parent-org API key, used only by `pnpm register-webhook`.
# Balance webhooks must be created in the parent (billing) organization.
TURNKEY_API_PUBLIC_KEY="<Parent org API public key>"
TURNKEY_API_PRIVATE_KEY="<Parent org API private key>"
# Public https URL of this app's webhook route, through a tunnel
WEBHOOK_URL="https://<your-tunnel>/api/webhooks/balances"

# Optional. Set to "false" to leave deposits in place (for trying the withdraw flow).
SWEEP_ENABLED="true"
