API_PUBLIC_KEY="<Turnkey API Public Key (that starts with 02 or 03)>"
API_PRIVATE_KEY="<Turnkey API Private Key>"
BASE_URL="https://api.turnkey.com"
ORGANIZATION_ID="<Turnkey organization ID>"
AGENT_PRIVATE_KEY_ID="<ID of a Turnkey CURVE_ED25519 private key that signs agent requests>"
ISSUER_PRIVATE_KEY_ID="<Optional: ID of a CURVE_ED25519 private key that signs attestations. Defaults to AGENT_PRIVATE_KEY_ID>"
