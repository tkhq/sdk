API_PUBLIC_KEY="<Turnkey API Public Key (that starts with 02 or 03)>"
API_PRIVATE_KEY="<Turnkey API Private Key>"
BASE_URL="https://api.turnkey.com"
ORGANIZATION_ID="<Turnkey organization ID>"
SUI_ADDRESS="<existing SUI address in your organization>"
SUI_PUBLIC_KEY="<existing SUI pubkey compressed matching your above address in your organization>"

# Optional: node provider URL used for broadcast, balance reads, and tx history.
# When unset the example falls back to the public testnet fullnode.
# QuickNode is the recommended provider for this demo.
QUICKNODE_SUI_URL=""
