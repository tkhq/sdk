TURNKEY_BASE_URL="https://api.turnkey.com"

# Parent org — used only by the one-time `pnpm deploy-vault` step and `pnpm fees`
PARENT_ORGANIZATION_ID="<parent org ID>"
PARENT_API_PUBLIC_KEY="<parent org API public key (starts with 02 or 03)>"
PARENT_API_PRIVATE_KEY="<parent org API private key>"

# Client performance fee, taken on yield. The fee wallet must be a
# Turnkey-managed wallet address in the parent org, on the same chain as
# CHAIN_CAIP2 (0x... on EVM, base58 on Solana).
CLIENT_FEE_BPS="2000"
CLIENT_FEE_WALLET="0x..."

# Demo org — runs the deposit/withdraw flow (can be the same as the parent org)
TURNKEY_ORGANIZATION_ID="<demo org ID>"
TURNKEY_API_PUBLIC_KEY="<demo org API public key>"
TURNKEY_API_PRIVATE_KEY="<demo org API private key>"

# Turnkey wallet address in the demo org, funded with USDC plus the chain's
# native token for fees when SPONSOR="false" (ETH on Base, SOL on Solana).
SIGN_WITH="0x..."

# Chain to run the demo on. Everything else defaults from this value.
#   eip155:8453                              Base (Morpho, Aave)
#   solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp  Solana mainnet (Kamino)
#   solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1  Solana devnet (Kamino)
# "solana:mainnet" and "solana:devnet" are accepted aliases.
CHAIN_CAIP2="eip155:8453"
# Underlying asset to look up in the vault catalog. Defaults to USDC on
# CHAIN_CAIP2; set it to use another asset.
ASSET_CAIP19=
# Catalog provider filter. Defaults to EARN_PROVIDER_MORPHO on EVM and
# EARN_PROVIDER_KAMINO on Solana; EARN_PROVIDER_AAVE lists Aave reserves.
EARN_PROVIDER=
# Vault to enable/deposit into; leave empty to pick the top catalog vault at
# deploy time. On EVM it must come from the catalog (Morpho VaultV2 — v1
# MetaMorpho vaults are not wrappable — or an Aave reserve's asset address).
# On Solana it is a Kamino K-Lend reserve address. Required on Solana devnet,
# which has no catalog: Turnkey's e2e uses the devnet USDC reserve
# XDU6q8pGhErjjG2bF4UDj4ZASUiUTuTDKnKkhHxWwPJ.
VAULT_ADDRESS=
DEPOSIT_ASSETS="1000000"  # 1 USDC (6 decimals)
WITHDRAW_ASSETS="500000"  # 0.5 USDC
SPONSOR="false"

# Optional RPC overrides for the on-chain helpers (`pnpm transfer`, EVM vault
# name lookup). Defaults to a public endpoint for the chain.
EVM_RPC_URL=
SOLANA_RPC_URL=
