# Copy to .env.local — NEVER commit real keys
BASE_URL=https://api.turnkey.com

# Parent organization: creates the customer sub-org
API_PUBLIC_KEY=your_parent_public_key
API_PRIVATE_KEY=your_parent_private_key
ORGANIZATION_ID=your_parent_org_id

# Platform's delegated key: non-root in the customer sub-org, limited by policy
DELEGATED_API_PUBLIC_KEY=your_delegated_public_key
DELEGATED_API_PRIVATE_KEY=your_delegated_private_key

# Mock customer key: the only root of the customer sub-org (stands in for the customer's own login).
# Generate a fresh pair for this demo; don't reuse a key that's in another sub-org.
CUSTOMER_API_PUBLIC_KEY=your_customer_public_key
CUSTOMER_API_PRIVATE_KEY=your_customer_private_key
